# Public URL shown by /api/v1/stats and used by the frontend copy.
SPELL_PUBLIC_URL=https://spell.lab

# API listener and database path (inside the container these are fixed).
SPELL_BIND=0.0.0.0:8080
SPELL_DB_PATH=/data/spell.db

# Engine limits.
SPELL_MAX_TEXT_CHARS=20000
SPELL_DEFAULT_MAX_SUGGESTIONS=5
SPELL_MAX_SUGGESTIONS_LIMIT=20
SPELL_DEFAULT_MAX_DISTANCE=2
SPELL_MAX_DISTANCE_LIMIT=3
SPELL_DEFAULT_MIN_CONFIDENCE=0
SPELL_SUGGESTION_CACHE_ENTRIES=10000

# Logging.
RUST_LOG=info,tower_http=info

# Host port for the web container in docker-compose.yml.
SPELL_WEB_PORT=8098
